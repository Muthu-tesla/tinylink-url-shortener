# ==============================================================================
# TinyLink Backend Environment Configuration (Template)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your actual .env file with secrets into version control!
# ==============================================================================

# Database Connection (PostgreSQL)
# Local: postgresql+psycopg://fastapi_user:fastapi123@localhost:5432/fastapi_db
# Cloud (Neon / Supabase): postgresql+psycopg://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/fastapi_db

# JWT Authentication Secret (Use a strong random 32+ character string in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated URLs without trailing slash)
# Include your Vercel deployment URL in production (e.g., https://your-tinylink.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Public Short Link Base Domain (Optional, defaults to request.base_url)
# Set this to your deployed Render URL or custom domain (e.g., https://tinylink-api.onrender.com)
BASE_SHORT_URL=

# Reverse Proxy Security
# Set to true when running behind Render, Cloudflare, or AWS ALB to trust proxy headers safely
TRUST_PROXY_HEADERS=false

# Rate Limiting Settings
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Redis Cache (Leave empty to use built-in process-local resilient fallback)
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
